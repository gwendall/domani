{
  "name": "domani-cli",
  "version": "0.4.42",
  "type": "module",
  "description": "Domain infrastructure for AI agents. Search, register, DNS, email, connect - all from your terminal. Installs the `domani` command.",
  "license": "MIT",
  "author": "domani.run",
  "homepage": "https://domani.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwendall/domani.git"
  },
  "bin": {
    "domani": "dist/domani.cjs"
  },
  "files": [
    "dist/domani.cjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "node build.mjs",
    "install:local": "node build.mjs && cp dist/domani.cjs $(which domani)",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test src/__tests__/*.test.ts",
    "test:e2e": "npx tsx --test src/__tests__/e2e/*.test.ts",
    "test:e2e:full": "E2E_MUTATE=1 npx tsx --test src/__tests__/e2e/*.test.ts",
    "test:all": "npx tsx --test src/__tests__/*.test.ts src/__tests__/e2e/*.test.ts",
    "dev": "tsc --watch"
  },
  "keywords": [
    "domain",
    "domains",
    "dns",
    "registrar",
    "cli",
    "email",
    "mcp",
    "ai-agent",
    "whois",
    "nameserver",
    "transfer",
    "ssl",
    "parking",
    "webhooks",
    "x402",
    "usdc"
  ],
  "dependencies": {
    "@clack/prompts": "1.0.1",
    "commander": "13.1.0",
    "picocolors": "1.1.1",
    "yocto-spinner": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.33",
    "esbuild": "0.27.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
